{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(hids-train:*)",
      "Bash(hids-eval:*)",
      "Bash(pytest:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./normal_training.sc)",
      "Read(./ApachePHP_normal.sc)",
      "Read(./LID-DS_DATASET/**)",
      "Read(./DATASET*/**)"
    ]
  }
}
